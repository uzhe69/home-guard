{
  "expo": {
    "name": "Home Guard",
    "slug": "home-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homeguard",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAF8",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.homeguard.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "NSLocationWhenInUseUsageDescription": "Home Guard uses your location to set your home radius.",
        "NSLocationAlwaysUsageDescription": "Home Guard monitors when you leave so it can check active appliances.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Home Guard monitors when you leave so it can check active appliances."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.homeguard.mobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAF8",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Home Guard uses your location to set your home radius.",
          "locationAlwaysPermission": "Home Guard monitors when you leave so it can check active appliances.",
          "locationAlwaysAndWhenInUsePermission": "Home Guard monitors when you leave so it can check active appliances.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
